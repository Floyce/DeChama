# Database Configuration
POSTGRES_USER=impact_user
POSTGRES_PASSWORD=impact_pass_2026
POSTGRES_DB=impact_chain
DATABASE_URL=postgresql+asyncpg://impact_user:impact_pass_2026@db:5432/impact_chain

# JWT Security
JWT_SECRET=your_super_secret_random_string_here_min_32_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Lightning Network (LND)
LND_GRPC_HOST=localhost:10009
LND_MACAROON_PATH=/app/certs/admin.macaroon
LND_TLS_CERT_PATH=/app/certs/tls.cert

# Stacks / NFT Sidechain
STACKS_API_KEY=your_stacks_api_key
STACKS_NETWORK=mainnet
PINATA_API_KEY=your_pinata_key
PINATA_SECRET=your_pinata_secret

# Notifications
SENDGRID_API_KEY=your_sendgrid_key
EMAIL_FROM=noreply@impactchain.com
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_PHONE_NUMBER=+1234567890

# App Settings
DEBUG=True
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
